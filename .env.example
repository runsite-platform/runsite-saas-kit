# Runsite SaaS Kit configuration.
# Local development: cp .env.example .env
# On Runsite, the template sets DATABASE_URL, JWT_SECRET, APP_URL, the S3 variables, EMAIL_API_KEY, EMAIL_FROM
# and BRAND_NAME. Every optional variable switches on one feature; leave it empty to keep the feature off.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# PostgreSQL URL; postgres:// and postgresql:// are switched to postgresql+asyncpg:// automatically
DATABASE_URL=postgresql://saaskit:saaskit@localhost:5432/saaskit
# Secret for signing access tokens; use a random 64-character string in production
JWT_SECRET=change-me-to-a-random-64-character-string-before-deploying-anywhere
# Public URL of the app (email links, OAuth redirects, billing return URLs); https:// turns on secure cookies.
# In local dev this is the Vite server. No trailing slash.
APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# Verbose logging; with no EMAIL_API_KEY the text of every email is logged too (copy verification links from there)
DEBUG=true
# Product name shown in the UI and emails (returned by /api/config/public)
BRAND_NAME=Acme
# Directory with the built SPA; the default (<project>/frontend/dist) is right for Docker and local builds
# FRONTEND_DIST_DIR=
# How many proxies in front of the app append to X-Forwarded-For (1 behind the Runsite proxy); the rate limit
# takes the client IP from that hop, because the leftmost entries are set by the client. 0 ignores the header.
# TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Email (Runsite email API); without EMAIL_API_KEY emails are only logged
# ---------------------------------------------------------------------------
# Runsite email API key
EMAIL_API_KEY=
# Runsite email API endpoint
EMAIL_API_URL=https://api.runsite.app/emails
# Sender shown in outgoing emails. In sandbox mode Runsite sends from its shared sandbox sender and puts this
# address in Reply-To.
EMAIL_FROM=Acme <noreply@example.com>
# Optional Reply-To for every email, for example a support inbox. Empty: replies go to EMAIL_FROM.
# In sandbox mode Runsite may replace Reply-To with EMAIL_FROM.
EMAIL_REPLY_TO=
# Require a verified email before inviting members and starting checkout.
# Turn on only after your sender domain is verified (sandbox mode delivers only to verified recipients).
REQUIRE_EMAIL_VERIFICATION=false

# ---------------------------------------------------------------------------
# Object storage (Runsite S3; MinIO from docker-compose locally); empty S3_BUCKET disables uploads
# ---------------------------------------------------------------------------
# S3 access key id (also used to delete objects unless S3_DELETE_* is set)
S3_ACCESS_KEY_ID=saaskit
# S3 secret access key
S3_SECRET_ACCESS_KEY=saaskit-secret
# S3 endpoint URL
S3_ENDPOINT_URL=http://localhost:9000
# Bucket for uploaded files
S3_BUCKET=saaskit
# S3 region ("auto" works for Runsite and MinIO)
S3_REGION=auto
# Optional key used only for deleting objects; empty means the main key above deletes.
# Needed only when the main key cannot delete, e.g. credentials injected by a Runsite dashboard connection.
# Template deploys and MinIO keys can delete, so leave both empty there.
S3_DELETE_ACCESS_KEY_ID=
# Secret for the optional delete key
S3_DELETE_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Google login; both values enable the "Continue with Google" button
# Redirect URI to register in Google Cloud: <APP_URL>/api/auth/google/callback
# ---------------------------------------------------------------------------
# Google OAuth client id
GOOGLE_CLIENT_ID=
# Google OAuth client secret
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Billing; empty BILLING_PROVIDER disables billing (everyone stays on the free plan)
# ---------------------------------------------------------------------------
# Active provider: stripe, lemonsqueezy or creem (one per deployment)
BILLING_PROVIDER=
# Register this webhook URL in the provider dashboard: <APP_URL>/api/webhooks/billing/<provider>
# Trials: Stripe gets trial_period_days from trial_days in backend/app/services/billing/plans.py (14 days for Pro).
# Lemon Squeezy and Creem ignore that value: configure the free trial on the variant/product in their dashboards
# and keep its length equal to trial_days so the pricing page shows the right number.
#
# Stripe webhook events: customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed
# Stripe secret API key
STRIPE_SECRET_KEY=
# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=
# Stripe price id for Pro monthly
STRIPE_PRICE_PRO_MONTHLY=
# Stripe price id for Pro yearly
STRIPE_PRICE_PRO_YEARLY=
#
# Lemon Squeezy webhook events: subscription_created, subscription_updated, subscription_cancelled,
# subscription_resumed, subscription_expired, subscription_paused, subscription_unpaused,
# subscription_payment_success, subscription_payment_failed, subscription_payment_recovered
# Lemon Squeezy API key (a test-mode key creates test-mode checkouts)
LEMONSQUEEZY_API_KEY=
# Lemon Squeezy store id
LEMONSQUEEZY_STORE_ID=
# Lemon Squeezy webhook signing secret
LEMONSQUEEZY_WEBHOOK_SECRET=
# Lemon Squeezy variant id for Pro monthly
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
# Lemon Squeezy variant id for Pro yearly
LEMONSQUEEZY_VARIANT_PRO_YEARLY=
#
# Creem webhook events: checkout.completed, subscription.active, subscription.trialing, subscription.paid,
# subscription.update, subscription.past_due, subscription.unpaid, subscription.paused,
# subscription.scheduled_cancel, subscription.canceled, subscription.expired
# Creem API key (test keys only work with the test API URL)
CREEM_API_KEY=
# Creem API base URL: https://test-api.creem.io in test mode, https://api.creem.io in production
CREEM_API_URL=https://api.creem.io
# Creem webhook signing secret
CREEM_WEBHOOK_SECRET=
# Creem product id for Pro monthly
CREEM_PRODUCT_PRO_MONTHLY=
# Creem product id for Pro yearly
CREEM_PRODUCT_PRO_YEARLY=

# ---------------------------------------------------------------------------
# Platform admin
# ---------------------------------------------------------------------------
# User with this email becomes superadmin on registration and at startup
SUPERADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Local development only (docker-compose host ports, tests, Makefile); not read by the app
# ---------------------------------------------------------------------------
# Host port for PostgreSQL (change DATABASE_URL too when you change it)
# POSTGRES_PORT=5432
# Host ports for Mailpit SMTP and web UI
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# Host ports for the MinIO API and console (change S3_ENDPOINT_URL too)
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# Port for `make dev-backend` (`make dev-frontend` points the Vite proxy at it)
# BACKEND_PORT=8000
# Vite proxy target for /api when you run `npm run dev` yourself instead of `make dev-frontend` (shell variable)
# VITE_API_PROXY_TARGET=http://localhost:8000
# Test database for `make test-backend`; derived from POSTGRES_PORT when unset. Export it for direct pytest runs.
# TEST_DATABASE_URL=postgresql+asyncpg://saaskit:saaskit@localhost:5432/saaskit_test
